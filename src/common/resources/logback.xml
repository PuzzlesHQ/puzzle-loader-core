<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <conversionRule conversionWord="lvlcolor" converterClass="dev.puzzleshq.puzzleloader.loader.util.LevelColorConverter" />
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>
        <encoder>
            <pattern>%blue([%thread]) [%lvlcolor(%level)] %magenta([%logger{36}]): %white(%msg)\n</pattern>
        </encoder>
    </appender>

    <root level="info">
        <appender-ref ref="console" />
    </root>
</configuration>